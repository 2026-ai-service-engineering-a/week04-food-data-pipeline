# ── 이번 주는 LLM이 주인공이 아니다 ───────────────────────────────────
# v0.1 투어, 1회전 정제, 2회전 PostgreSQL 검색은 키가 없어도 전부 돈다.
# LLM이 등장하는 곳은 딱 두 군데다:
#   1회전 — 규칙이 못 푼 섭취참고량의 잔여 파싱 (고유값 34개뿐이라 사실상 공짜)
#   3회전 — 검색이 추린 top-5로 답하는 RAG (런타임)

# 잔여 파싱과 RAG 답변이 함께 쓰는 모델. 3주차 키를 그대로 재사용하면 된다.
# LiteLLM 모델 문자열의 접두사(openai/ · anthropic/ · gemini/)가 프로바이더를 정한다.
PARSER_MODEL=openai/gpt-5-mini

# 임베딩 — 3회전 벡터 인덱스와 의미 검색 질의에 쓴다.
# 생성 모델과 가격 자릿수가 다르다 (100만 토큰에 $0.15 수준).
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768 # 기본 3072를 그대로 31만 건 저장하면 인덱스가 수 GB가 된다

# ── 프로바이더 키 ────────────────────────────────────────────────────
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
# Gemini:    https://aistudio.google.com/apikey (무료 발급 — 임베딩은 여기 키)
#
# 배포된 산출물(정제 parquet · pg 덤프 · chroma 인덱스)을 받아 쓰면
# 무거운 배치는 건너뛴다. 그때 키가 실제로 필요한 곳은 의미 검색의 질의
# 임베딩(질의 한 건이라 사실상 공짜)과 /ask의 답변 생성뿐이다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 저장소 ───────────────────────────────────────────────────────────
# db 서비스는 2회전이, chroma 서비스는 3회전이 compose에 추가한다.
DATABASE_URL=postgresql://app:app@db:5432/food
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ── 배치 안전장치 기본값 ─────────────────────────────────────────────
# 31만 건을 그냥 돌리면 지갑이 터진다. 상한을 걸고 시작하는 것이 기본값이다.
LLM_LIMIT=100        # 1회전 잔여 파싱 1회 실행당 LLM 호출 상한
EMBED_LIMIT=0        # 3회전 임베딩 상한 (0이면 무제한)
EMBED_BATCH_SIZE=100 # 임베딩 배치 묶음 크기

# ── 로깅 ─────────────────────────────────────────────────────────────
# debug면 배치 LLM의 프롬프트 전문·모델 원출력·건별 토큰·비용과
# RAG의 조립된 컨텍스트 전문이 로그에 남는다. 관측 가능성도 요구사항이다.
LOG_LEVEL=info
